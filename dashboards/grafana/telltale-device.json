{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Where telltale metrics are scraped or written",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "telltale — device health",
  "description": "Reference dashboard for devices exporting telltale metrics. Built around the three questions that matter for a fleet: is it restarting, is it running out of memory, and can it hear the network.",
  "uid": "telltale-device",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["telltale", "iot", "device-health"],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(device_uptime_seconds, device_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is it restarting?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Devices rebooted in the last hour",
      "description": "A device whose boot counter moved is a device that restarted. This is the number to alert on; uptime alone hides a reboot loop between two scrapes.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(increase(device_boot_count_total{device_id=~\"$device\"}[1h]) > 0) or vector(0)",
          "legendFormat": "devices"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Devices whose last reset was a fault",
      "description": "Panic, watchdog or brownout. A planned OTA reboot does not appear here; this panel is only unintended restarts.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(device_reset_fault{device_id=~\"$device\"} == 1) or vector(0)",
          "legendFormat": "devices"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "piechart",
      "title": "Why devices restarted",
      "description": "The distribution that tells you which problem you have: power_on means supply, panic means firmware, brownout means battery or regulator.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (reason) (device_reset_info{device_id=~\"$device\"} == 1)",
          "legendFormat": "{{reason}}"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } }
    },
    {
      "type": "timeseries",
      "title": "Uptime",
      "description": "A sawtooth here is a reboot loop. A flat line at a low value is a device stuck restarting faster than the scrape interval.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "device_uptime_seconds{device_id=~\"$device\"}",
          "legendFormat": "{{device_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 5 } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Is it running out of memory?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Free heap, and the lowest it has been",
      "description": "The dashed series is the minimum since boot. Sampling every 30 s misses the trough; the minimum does not.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "device_heap_free_bytes{device_id=~\"$device\"}",
          "legendFormat": "{{device_id}} free"
        },
        {
          "refId": "B",
          "expr": "device_heap_min_free_bytes{device_id=~\"$device\"}",
          "legendFormat": "{{device_id}} min since boot"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 1, "fillOpacity": 5 } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*min since boot" },
            "properties": [{ "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Heap fragmentation",
      "description": "1 - largest free block / free heap. Above 0.8 a device can fail an allocation while reporting plenty of free memory, which is the failure that looks like a mystery in the field.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "device_heap_fragmentation_ratio{device_id=~\"$device\"}",
          "legendFormat": "{{device_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.6 },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Task stack headroom (smallest ever)",
      "description": "The FreeRTOS high-water mark per watched task. Anything under ~512 bytes is a stack overflow waiting for a slightly deeper call path.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (device_id, task) (device_task_stack_free_bytes{device_id=~\"$device\"})",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "align": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 512 },
              { "color": "green", "value": 1024 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-background" } }]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Can it hear the network?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Link RSSI",
      "description": "Gaps are honest: telltale reports no RSSI while disassociated, because 0 dBm would read as a perfect signal.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "link_rssi_dbm{device_id=~\"$device\"}",
          "legendFormat": "{{device_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "max": -30,
          "min": -100,
          "custom": { "lineWidth": 1, "fillOpacity": 0, "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -80 },
              { "color": "green", "value": -67 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Disconnections per hour",
      "description": "A device that reconnects constantly drains its battery and loses telemetry, while never appearing 'down' in a simple up/down check.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(link_disconnect_count_total{device_id=~\"$device\"}[1h])",
          "legendFormat": "{{device_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      }
    }
  ]
}
